{
  "name": "@mine/site",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "npm run clear && npm run route && next build --webpack",
    "build-storybook": "storybook build",
    "clear": "rm -rf public/static && rm -rf .next",
    "create-app": "node ./scripts/create-app.mjs",
    "dev": "next dev --webpack",
    "dev:": "next dev --webpack",
    "export:analyze": "cross-env DEPLOY_MODE=export DEPLOY_ENV=local ANALYZE=true npm run build",
    "export:domain": "cross-env DEPLOY_MODE=export DEPLOY_ENV=domain npm run build",
    "export:local": "cross-env DEPLOY_MODE=export DEPLOY_ENV=local npm run build",
    "file-type": "ts-node ./scripts/file-type.mjs",
    "lint:es": "eslint --ext .js,.mjs,.ts,.tsx ./",
    "lint:es-fix": "npm run lint:es -- --fix",
    "qr": "ts-node ./scripts/qr.mjs",
    "route": "rollup-node ./scripts/route.ts ./scripts/tsconfig.route.json",
    "serve": "next start",
    "storybook": "storybook dev -p 6006",
    "ts:check": "tsc --noEmit"
  },
  "browserslist": {
    "production": [
      "last 1 chrome version"
    ],
    "development": [
      "last 1 chrome version"
    ]
  },
  "dependencies": {
    "@chromatic-com/storybook": "^3.2.4",
    "@emotion/react": "^11.11.4",
    "@emotion/styled": "^11.11.5",
    "@mine/markdown-loader": "^0.0.0",
    "@mine/rollup-node": "^0.0.0",
    "@mui/icons-material": "^6.1.6",
    "@mui/lab": "^6.0.0-beta.14",
    "@mui/material": "^6.1.6",
    "@mui/system": "^6.1.6",
    "@mui/x-date-pickers": "^7.29.4",
    "@next/bundle-analyzer": "^16.4.0",
    "@storybook/addon-essentials": "^8.5.0",
    "@storybook/addon-interactions": "^8.5.0",
    "@storybook/addon-links": "^8.5.0",
    "@storybook/addon-onboarding": "^8.5.0",
    "@storybook/blocks": "^8.5.0",
    "@storybook/nextjs": "^8.5.0",
    "@storybook/react": "^8.5.0",
    "@storybook/test": "^8.5.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/lodash": "^4.14.178",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "browserslist": "^4.23.1",
    "chalk": "^6.0.1",
    "classnames": "^2.5.1",
    "cross-env": "^10.1.0",
    "dayjs": "^1.11.0",
    "disqus-react": "^1.1.7",
    "eslint-plugin-storybook": "^0.8.0",
    "file-loader": "^6.2.0",
    "fs-extra": "^11.1.0",
    "highlight.js": "^11.8.0",
    "html2canvas": "^1.4.0",
    "inquirer": "^14.2.3",
    "internal-ip": "^9.0.0",
    "lodash": "^4.17.21",
    "log-symbols": "^7.0.0",
    "mobx": "^7.0.6",
    "mobx-react-lite": "5.1.0",
    "next": "^16.4.0",
    "pinyin": "^4.0.0",
    "qrcode-terminal": "^0.12.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-image-crop": "^11.0.1",
    "react-markdown": "^8.0.0",
    "rehype-raw": "^6.1.0",
    "rehype-sanitize": "^5.0.0",
    "remark-gfm": "^3.0.1",
    "sass": "^1.77.4",
    "storybook": "^8.5.0",
    "swiper": "^14.3.0",
    "three": "^0.186.1",
    "three-stdlib": "^2.36.1",
    "tslib": "^2.6.2",
    "typescript": "^5.7.3",
    "vitest": "^5.0.3",
    "webpack": "^5.91.0",
    "yaml-loader": "^0.9.0"
  }
}
